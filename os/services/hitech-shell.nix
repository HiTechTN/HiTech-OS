# HiTech-OS — NixOS module for the HiTech-Shell Wayland desktop environment.
#
# This module is the declarative contract for the Rust shell scaffold in
# `apps/hitech-shell`. The shell binary is still a placeholder; the options
# below are stable so other modules (installer, patient-zero, future images)
# can select a layout without knowing the compositor internals.
#
# Layout profiles:
#   hybrid  — Windows-style taskbar + start menu, plus Android-style quick
#             settings and a macOS/Windows hybrid workspace switcher.
#   mac     — macOS-style top menu bar + bottom dock + control centre.
#   windows — Windows-style taskbar/start menu/tray only.
#
# The generated `/etc/hitechos/hitech-shell.toml` is the single source of
# truth: it is read by the session (HITECH_SHELL_CONFIG) and by the compositor
# at runtime. `HITECH_SHELL_LAYOUT` is exported for tooling that cannot parse
# the file yet.

{ config, lib, pkgs, ... }:

let
  cfg = config.services.hitech-shell;

  hitechShell = pkgs.callPackage ../../apps/hitech-shell { };
in
{
  options.services.hitech-shell = {
    enable = lib.mkEnableOption "HiTech-Shell Wayland desktop environment";

    package = lib.mkOption {
      type = lib.types.package;
      default = hitechShell;
      defaultText = lib.literalExpression "pkgs.callPackage ../../apps/hitech-shell {}";
      description = "HiTech-Shell package to install and launch.";
    };

    layout = lib.mkOption {
      type = lib.types.enum [
        "hybrid"
        "mac"
        "windows"
      ];
      default = "hybrid";
      description = ''
        Shell layout profile. `hybrid` combines a Windows-style taskbar and
        start menu with an Android-style quick-settings panel and a
        macOS-style dock. `mac` uses a top menu bar + bottom dock. `windows`
        keeps the taskbar/start-menu/tray model only.
      '';
    };

    session = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = ''
          Register the HiTech-Shell package as a Wayland session with the
          active display manager (`services.displayManager.sessionPackages`).
          Disable for kiosk/embedded images that launch the shell directly.
        '';
      };
    };

    outputs = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ "*" ];
      description = ''
        Output names the shell should manage. `*` means all outputs. Used for
        per-monitor layout policies in a later Phase 8 iteration.
      '';
    };

    extraConfig = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = { };
      example = {
        theme = "hitechos-dark";
        quick_settings.enable = "true";
      };
      description = "Extra key/value pairs rendered into the shell config file.";
    };
  };

  config = lib.mkIf cfg.enable {
    environment.systemPackages = [ cfg.package ];

    environment.etc."hitechos/hitech-shell.toml".text = lib.concatStringsSep "\n" (
      [
        "# Generated by services.hitech-shell — do not edit by hand."
        "layout = \"${cfg.layout}\""
        "outputs = [ ${lib.concatMapStringsSep ", " (output: "\"${output}\"") cfg.outputs} ]"
        "session = ${lib.boolToString cfg.session.enable}"
      ]
      ++ lib.mapAttrsToList (key: value: "${key} = \"${value}\"") cfg.extraConfig
      ++ [ "" ]
    );

    environment.sessionVariables = {
      HITECH_SHELL_CONFIG = "/etc/hitechos/hitech-shell.toml";
      HITECH_SHELL_LAYOUT = cfg.layout;
      HITECH_SHELL_OUTPUTS = lib.concatStringsSep "," cfg.outputs;
    };

    services.displayManager.sessionPackages =
      lib.optional cfg.session.enable cfg.package;
  };
}
